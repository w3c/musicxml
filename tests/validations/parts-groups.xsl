                  </variable><message terminate="yes" error-code="Q{{http://dmaus.name/ns/2023/schxslt}}ValidationError"><text/><value-of select="normalize-space(string-join($message))"/></message></catch></try></svrl:schematron-output></template><template match="root()" as="element()*" mode="Q{http://dmaus.name/ns/2023/schxslt}validate"><apply-templates select="root()" mode="group.d6e10"/></template><function name="Q{http://dmaus.name/ns/2023/schxslt}numeric-severity" as="Q{http://www.w3.org/2001/XMLSchema}integer"><param name="severity" as="Q{http://www.w3.org/2001/XMLSchema}string"/><sequence select="(index-of(('info', 'warning', 'error', 'fatal'), $severity), 4)[1]"/></function></stylesheet>
