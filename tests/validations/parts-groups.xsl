<?xml version="1.0" encoding="UTF-8"?><stylesheet xmlns="http://www.w3.org/1999/XSL/Transform" xmlns:svrl="http://purl.oclc.org/dsdl/svrl" version="3.0" expand-text="false"><variable name="Q{http://dmaus.name/ns/2023/schxslt}phase" as="Q{http://www.w3.org/2001/XMLSchema}string" select="'#ALL'"/><mode use-accumulators=""/><mode name="Q{http://dmaus.name/ns/2023/schxslt}validate" use-accumulators="" on-no-match="shallow-skip"/><mode name="group.d6e10" on-no-match="shallow-skip" streamable="false" use-accumulators=""/><template match="* | root()" mode="group.d6e10" priority="-10"><apply-templates select="@*" mode="#current"/><apply-templates select="node()" mode="#current"/></template><template match="part-symbol" mode="group.d6e10" priority="0"><param name="Q{http://dmaus.name/ns/2023/schxslt}pattern" as="Q{http://www.w3.org/2001/XMLSchema}string*" select="()"/><variable name="Q{http://dmaus.name/ns/2023/schxslt}rule-context" as="node()" select="."/><choose><when test="'d6e10' = $Q{http://dmaus.name/ns/2023/schxslt}pattern"><next-match/></when><otherwise><variable name="Q{http://dmaus.name/ns/2023/schxslt}severity" as="map(Q{http://www.w3.org/2001/XMLSchema}string, Q{http://www.w3.org/2001/XMLSchema}integer)"><map><map-entry key="'d6e16'"><variable name="severity" as="Q{http://www.w3.org/2001/XMLSchema}string" select="'fatal'"/><sequence select="Q{http://dmaus.name/ns/2023/schxslt}numeric-severity($severity)"/></map-entry><map-entry key="'d6e23'"><variable name="severity" as="Q{http://www.w3.org/2001/XMLSchema}string" select="'fatal'"/><sequence select="Q{http://dmaus.name/ns/2023/schxslt}numeric-severity($severity)"/></map-entry></map></variable><for-each select="."><variable name="staves" select="(ancestor::attributes/staves/number(), ancestor::measure/preceding-sibling::measure[attributes/staves][last()]/attributes/staves/number(), 1)[1]"/><choose><when test="Q{http://www.w3.org/2005/xpath-functions/map}get($Q{http://dmaus.name/ns/2023/schxslt}severity, 'd6e16') ge Q{http://dmaus.name/ns/2023/schxslt}numeric-severity('info')"><if test="not(number(@top-staff) &lt;= $staves)"><variable name="failed-assert" as="element(svrl:failed-assert)"><svrl:failed-assert test="number(@top-staff) &lt;= $staves" patternId="staff-number-staves"><where-populated><attribute name="location" select="path($Q{http://dmaus.name/ns/2023/schxslt}rule-context)"/></where-populated><svrl:text>
        part-symbol/@top-staff=<for-each select=".[1]"><value-of select="@top-staff"/></for-each> should be within staves=<for-each select=".[1]"><value-of select="$staves"/></for-each>.
      </svrl:text></svrl:failed-assert></variable><sequence select="$failed-assert"/></if></when><otherwise/></choose><choose><when test="Q{http://www.w3.org/2005/xpath-functions/map}get($Q{http://dmaus.name/ns/2023/schxslt}severity, 'd6e23') ge Q{http://dmaus.name/ns/2023/schxslt}numeric-severity('info')"><if test="not(number(@bottom-staff) &lt;= $staves)"><variable name="failed-assert" as="element(svrl:failed-assert)"><svrl:failed-assert test="number(@bottom-staff) &lt;= $staves" patternId="staff-number-staves"><where-populated><attribute name="location" select="path($Q{http://dmaus.name/ns/2023/schxslt}rule-context)"/></where-populated><svrl:text>
        part-symbol/@bottom-staff=<for-each select=".[1]"><value-of select="@bottom-staff"/></for-each> should be within staves=<for-each select=".[1]"><value-of select="$staves"/></for-each>.
      </svrl:text></svrl:failed-assert></variable><sequence select="$failed-assert"/></if></when><otherwise/></choose></for-each><next-match><with-param name="Q{http://dmaus.name/ns/2023/schxslt}pattern" as="Q{http://www.w3.org/2001/XMLSchema}string*" select="('d6e10', $Q{http://dmaus.name/ns/2023/schxslt}pattern)"/></next-match></otherwise></choose></template><template match="root()" as="element(svrl:schematron-output)"><svrl:schematron-output phase="#ALL" title="Parts and groups"><!--SchXslt2 development--><try><apply-templates select="." mode="Q{http://dmaus.name/ns/2023/schxslt}validate"/><catch><svrl:error code="{$Q{http://www.w3.org/2005/xqt-errors}code}"><if test="(document-uri(.), base-uri(root()))[1]"><attribute name="document" select="(document-uri(.), base-uri(root()))[1]"/></if><if test="$Q{http://www.w3.org/2005/xqt-errors}line-number"><attribute name="line-number" select="$Q{http://www.w3.org/2005/xqt-errors}line-number"/></if><if test="$Q{http://www.w3.org/2005/xqt-errors}column-number"><attribute name="column-number" select="$Q{http://www.w3.org/2005/xqt-errors}column-number"/></if><if test="$Q{http://www.w3.org/2005/xqt-errors}description"><value-of select="$Q{http://www.w3.org/2005/xqt-errors}description"/></if></svrl:error><variable name="message" as="Q{http://www.w3.org/2001/XMLSchema}string+" expand-text="yes">
