{
  "name": "musicxml-docs",
  "description": "MusicXML documentation site.",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "astro dev",
    "build:schema": "for xsd in container musicxml opus sounds; do for xsl in elements elements-tree datatypes; do xslt3 -xsl:src/xsl/$xsl.xsl -s:../schema/$xsd.xsd > src/data/$xsl-$xsd.json; done; done",
    "build": "npm run build:schema && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "debug:xsl": "run() { xslt3 -xsl:src/xsl/\"$1\".xsl -s:../schema/\"$2\".xsd ${@:3}; }; run",
    "debug:xsd": "run() { xmllint --schema ../test/XMLSchema.xsd ../schema/\"$1\".xsd --noout; }; run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@selemondev/shiki-transformer-copy-button": "^1.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.2.6",
    "astro-pagefind": "^2.0.1",
    "astro-tooltips": "^0.6.2",
    "tailwindcss": "^4.3.0",
    "vite-plugin-restart": "^2.0.0",
    "xslt3": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
