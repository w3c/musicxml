{
  "name": "musicxml-docs",
  "description": "MusicXML documentation site.",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "astro dev",
    "build:schemas": "for xsd in container musicxml opus sounds; do for xsl in elements elements-tree datatypes; do xslt3 -xsl:src/xsl/$xsl.xsl -s:../schema/$xsd.xsd > src/data/$xsl-$xsd.json; done; done",
    "build": "npm run build:schemas && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "debug:xsl": "run() { xslt3 -xsl:src/xsl/\"$1\".xsl -s:../schema/\"$2\".xsd ${@:3}; }; run",
    "debug:xsd": "run() { xmllint --schema ../test/XMLSchema.xsd ../schema/\"$1\".xsd --noout; }; run"
  },
  "dependencies": {
    "@selemondev/shiki-transformer-copy-button": "^1.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.1.3",
    "astro-tooltips": "^0.6.2",
    "tailwindcss": "^4.3.0",
    "vite-plugin-restart": "^2.0.0",
    "xslt3": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
