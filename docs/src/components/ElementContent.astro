---
import DataTypeLink from '@components/DataTypeLink.astro';
import ElementLink from '@components/ElementLink.astro';

const { content, schema, parent } = Astro.props;

const cardinality = (() => {
  if (!content) return '';
  if (content.type === 'element' || content.type === 'sequence') {
    if (content.min === '0' && content.max === '0') {
      return "Forbidden";
    }
    if (content.min === '0' && content.max === '1') {
      return "Optional";
    }
    else if (content.min === '0' && content.max === 'unbounded') {
      return "Zero or more times";
    }
    else if (content.min === '1' && content.max === '1') {
      return "Required";
    }
    else if (content.min === '1' && content.max === 'unbounded') {
      return "One or more times";
    }
    else {
      return `${content.min} to ${content.max} times`;
    }
  }
  else if (content.type === 'choice') {
    if (content.min === '0' && content.max === '0') {
      return "None of the following";
    }
    if (content.min === '0' && content.max === '1') {
      return "Zero or one of the following";
    }
    else if (content.min === '0' && content.max === 'unbounded') {
      return "Zero or more of the following";
    }
    else if (content.min === '1' && content.max === '1') {
      return "Exactly one of the following";
    }
    else if (content.min === '1' && content.max === 'unbounded') {
      return "One or more of the following";
    }
    else {
      return `${content.min} to ${content.max} of the following`;
    }
  }
})();
---
{content ? (
  content.type === 'type' ? <DataTypeLink schema={schema} type={content.value} /> : (
    content.type === 'element' ? (
      <ElementLink tag={content.value} schema={schema} />
      <Fragment>{(parent?.type !== 'choice' || cardinality !== 'Required') && <span>&nbsp;({cardinality})</span>}</Fragment>
      ) : (
      content.type === 'sequence' ? (
        <span>In this order{cardinality !== 'Required' && <Fragment>&nbsp;({cardinality})</Fragment>}</span>
        <ul>
          {content.value.map(child => <li><Astro.self schema={schema} content={child} parent={content} /></li>)}
        </ul>
      ) : (
        <span>{cardinality}</span>
        <ul>
          {content.value.map(child => <li><Astro.self schema={schema} content={child} parent={content} /></li>)}
        </ul>
      )
    )
  )
) : <p>Always empty.</p>}
