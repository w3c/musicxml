---
import { Code } from 'astro:components';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import MarkdownIt from 'markdown-it';
import Path from 'node:path';
import { defaultElementsMap } from '../site.config';

const md = new MarkdownIt();
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/**/*.png');
const { example, schema } = Astro.props;
const snippet = example.rawContent().replace(/```xml|```/g, '').trim();
const name = Path.parse(example.file).name;
const image = example.frontmatter.image ? `/src/assets/img/${example.frontmatter.tutorial ? 'notation' : 'examples'}/${example.frontmatter.image}` : null;
---
{image && (
  <Image src={images[image]()} alt={name} />
)}
{example.frontmatter.description && (
  <p set:html={md.render(example.frontmatter.description)} />
)}
<p/>
<Code lang="xml" code={snippet}
transformers={[
  {
    line(node) {
      const opening = node.children.findIndex((child) => {
        return child.type === 'element' &&
                child.children.length === 1 &&
                child.children[0].type === 'text' &&
                (child.children[0].value.endsWith('<') || child.children[0].value.endsWith('</'))
      });
      if (opening > -1 && node.children.length > opening) {
        const child = node.children[opening + 1];
        if (
          child.type === 'element' &&
          child.children.length === 1 &&
          child.children[0].type === 'text'
        ) {
          let tag = child.children[0].value;
          if (example.frontmatter.elements_map && tag in example.frontmatter.elements_map) {
            tag = example.frontmatter.elements_map[tag];
          }
          else if (tag in defaultElementsMap) {
            tag = defaultElementsMap[tag];
          }
          child.tagName = 'a';
          child.properties.href = `/musicxml/${schema}-reference/elements/${tag}/`;
          if (Array.isArray(example.frontmatter.elements) ? example.frontmatter.elements.indexOf(tag) > -1 : example.frontmatter.elements === tag) {
            this.addClassToHast(child, 'highlighted-word');
          }
        }
      }
    }
  }
]}
/>
