---
import DocsIcon from '../assets/img/icons/document-code-twotone-rounded.svg';
import MenuIcon from '../assets/img/icons/menu-02-stroke-standard.svg';
---

<header class="sticky top-0 z-30 flex h-14 items-center px-4 border-b border-b-neutral-300 bg-olive-100/80 backdrop-blur md:px-10">

  <div class="flex">
    <button type="button" title="Menu" class="relative w-7 h-7 text-zinc-600">
      <MenuIcon class="absolute top-0 left-0" />
    </button>
  </div>

  <a href="/" class="flex items-center mx-auto font-bold text-zinc-700 no-underline">
    <DocsIcon class="w-7 mr-2" />
    <div>MusicXML 4.1</div>
  </a>

</header>