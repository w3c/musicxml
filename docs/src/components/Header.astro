---
import { url } from '../utils';
import { siteInfo } from '../site.config';
import DocsIcon from '@icons/document-code-twotone-rounded.svg';
import MenuIcon from '@icons/menu-02-stroke-standard.svg';
---

<header class="sticky top-0 z-30 flex h-14 items-center px-4 border-b border-b-neutral-300 bg-olive-100/80 backdrop-blur md:px-10">

  <div class="flex">
    <button id="menu-btn" type="button" title="Show/Hide the Menu" class="relative w-7 h-7 text-zinc-600" aria-controls="site-nav">
      <MenuIcon class="absolute top-0 left-0" />
    </button>
  </div>

  <a href={ url('') } class="absolute left-1/2 -translate-x-1/2 flex items-center font-bold text-zinc-700">
    <DocsIcon class="w-7 mr-2" />
    <div>{ siteInfo.title } { siteInfo.specVersion } { siteInfo.isDraft && 'Draft' }</div>
  </a>

</header>