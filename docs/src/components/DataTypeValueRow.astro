---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { annotationMarkdown } from '../utils';

interface Props {
  datatype: CollectionEntry<'musicxmlDatatypes' | 'containerDatatypes' | 'opusDatatypes' | 'soundsDatatypes'>,
  value: any
}

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/datatypes/**/*.png');
const { datatype, value, schema } = Astro.props;
const image = `/src/assets/img/datatypes/${schema}/${datatype.data.name}-${value.value.replace(/\s/, '-')}.png`;
const display = !value.value.length ? '<empty string>' : value.value;
---
<tr>
  <td>{display}</td>
  <td>
  {image in images && <Image src={images[image]()} alt={`${datatype.data.name}: ${display}`} />}
  {value.documentation && <Fragment set:html={annotationMarkdown(value.documentation)}/>}
  </tr>
</tr>
