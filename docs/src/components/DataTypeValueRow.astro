---
import MarkdownIt from 'markdown-it';
import { Image } from 'astro:assets';

const md = new MarkdownIt();
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/datatypes/*.png');
const { datatype, value } = Astro.props;
const image = `/src/assets/img/datatypes/${datatype.data.name}-${value.value.replace(/\s/, '-')}.png`;
const display = !value.value.length ? '(empty string)' : value.value;
---
<tr>
  <td>{display}</td>
  <td>{value.documentation && <Fragment set:html={md.render(value.documentation)}/>}</td>
  <td>{image in images && <Image src={images[image]()} alt={display} />}</td>
</tr>
