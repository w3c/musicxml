---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import DataTypeLink from './DataTypeLink.astro';
import ElementLink from './ElementLink.astro';
import DataTypeValueRow from './DataTypeValueRow.astro';

interface Props {
  datatype: CollectionEntry<'musicxmlDatatypes' | 'containerDatatypes' | 'opusDatatypes' | 'soundsDatatypes'>,
  schema: string
}

const processor = await createMarkdownProcessor();
const elements = await getCollection('musicxmlElements');
const { datatype, schema } = Astro.props;
const usages = elements.reduce((usages, element) => {
  if (element.data.children && element.data.children.type === 'type' && element.data.children.value === datatype.data.name) {
    usages.push({ element });
  }
  element.data.attributes?.forEach(attribute => {
    if (attribute.type === datatype.data.name) {
      usages.push({ element, attribute });
    }
  })
  return usages;
}, ([] as any[])).sort((a,b) => {
  // Objects without attribute come first, thanks Copilot.
  const aHasAttribute = 'attribute' in a;
  const bHasAttribute = 'attribute' in b;
  if (!aHasAttribute && bHasAttribute) return -1;
  if (aHasAttribute && !bHasAttribute) return 1;
  return 0;
});
---
{datatype.data.documentation && <p class="description" set:html={(await processor.render(datatype.data.documentation)).code} />}

{(datatype.data.base || datatype.data.type) && <section class="values">
  <h2>Allowed values</h2>
  {datatype.data.base && <p class="bases">Base type{datatype.data.base.length > 1 && 's'}:
    {datatype.data.base.sort((a,b) => a.localeCompare(b)).map(base => <DataTypeLink type={base} schema={schema}/>)}
  </p>}

  {datatype.data.type === 'values' ? (
    <table class="musicxml">
      <tbody>
        {datatype.data.value.sort((a,b) => {
          // "yes" always comes first, "no" always second, thanks Copilot.
          const order: any = { 'yes': 0, 'no': 1, 'on': 0, 'off': 1 };
          const oa = order[a.value] ?? 2;
          const ob = order[b.value] ?? 2;
          if (oa !== ob) return oa - ob;
          return a.value.localeCompare(b.value);
        }).map(value => <DataTypeValueRow datatype={datatype} value={value} />)}
      </tbody>
    </table>
  ) : datatype.data.type === 'regex' ? (
    <Fragment set:html={(await processor.render(`Regex pattern: \`${datatype.data.value}\``)).code}/>
  ) : datatype.data.type === 'range' ? (
    <Fragment>
      {'minInclusive' in datatype.data.value && <p>Minimum allowed value: <span class="range">{datatype.data.value.minInclusive}</span></p>}
      {'minExclusive' in datatype.data.value && <p>Minimum allowed value: <span class="range">&gt; {datatype.data.value.minExclusive}</span></p>}
      {'maxInclusive' in datatype.data.value && <p>Maximum allowed value: <span class="range">{datatype.data.value.maxInclusive}</span></p>}
      {'maxExclusive' in datatype.data.value && <p>Maximum allowed value: <span class="range">&lt; {datatype.data.value.maxExclusive}</span></p>}
    </Fragment>
  ) : ''}
</section>}

{usages.length > 0 && <section class="usage">
  <h2>Where is this type used?</h2>
  {usages.map(usage => <p><ElementLink schema={schema} tag={usage.element.data.name}/>{usage.attribute && <span> — “{usage.attribute.name}” attribute</span>}</p>)}
</section>}
