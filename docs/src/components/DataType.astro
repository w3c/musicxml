---
import { getCollection } from 'astro:content';

import MarkdownIt from 'markdown-it';
import DataTypeLink from './DataTypeLink.astro';
import ElementLink from './ElementLink.astro';

const md = new MarkdownIt();
const elements = await getCollection('musicxmlElements');
const { datatype, schema } = Astro.props;
const usages = elements.reduce((usages, element) => {
  if (element.data.children && element.data.children.type === 'type' && element.data.children.value === datatype.data.name) {
    usages.push({ element });
  }
  element.data.attributes?.forEach((attribute) => {
    if (attribute.type === datatype.data.name) {
      usages.push({ element, attribute });
    }
  })
  return usages;
}, ([] as any[])).sort((a, b) => {
  const aHasAttribute = 'attribute' in a;
  const bHasAttribute = 'attribute' in b;

  // Objects without attribute come first
  if (!aHasAttribute && bHasAttribute) return -1;
  if (aHasAttribute && !bHasAttribute) return 1;
  return 0;
});
---
{datatype.data.documentation && <p class="description" set:html={md.render(datatype.data.documentation)} />}

{datatype.data.base && <p>Base type: <DataTypeLink type={datatype.data.base} schema={schema}/></p>}

<section class="values">
  <h2>Allowed values</h2>
</section>

<section class="usage">
  <h2>Where is this type used?</h2>
  {usages.map((usage) => <p><ElementLink schema={schema} tag={usage.element.data.name}/>{usage.attribute && <span> — “{usage.attribute.name}” attribute</span>}</p>)}
</section>
