---
import { getCollection } from 'astro:content';

import BaseLayout from '@layouts/Base.astro';
import ElementLink from '@components/ElementLink.astro';
import SchemaView from '@components/SchemaView.astro';

const elements = await getCollection('opusElements');
const frontmatter = {
  title: 'Elements used in Opus'
}
---
<BaseLayout frontmatter={frontmatter}>
  <SchemaView schema="opus" current="list"/>
  <ul>
    {elements.map(element => (
      <li><ElementLink tag={element.id} schema="opus"/></li>
    ))}
  </ul>
</BaseLayout>
