---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/Base.astro';
import { url } from '../../../utils';

const examples = await getCollection('soundsExamples');
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/**/*.png');

const frontmatter = {
  title: 'Sounds example documents',
}
---
<BaseLayout frontmatter={frontmatter}>
  {Object.values(examples).sort((a,b) => a.data.title.localeCompare(b.data.title)).map(example => {
    const name = Path.parse(example.filePath!).name;
    const image = `/src/assets/img/${example.data.tutorial ? 'tutorial' : 'examples'}/${name}.png`;
    return (
      <Fragment>{image in images && <Image src={images[image]()} alt={name} />}</Fragment>
      <a href={url(`sounds-reference/examples/${example.id}/`)}>{example.data.title}</a>
      <p/>
    );
  })}
</BaseLayout>
