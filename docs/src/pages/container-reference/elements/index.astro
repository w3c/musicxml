---
import { getCollection } from 'astro:content';

import BaseLayout from '../../../layouts/Base.astro';
import ElementLink from '@components/ElementLink.astro';

const elements = await getCollection('containerElements');
const frontmatter = {
  title: 'Elements used in Container'
}
---
<BaseLayout frontmatter={frontmatter}>
  <ul>
    {elements.map(element => (
      <li><ElementLink tag={element.id} schema="container"/></li>
    ))}
  </ul>
</BaseLayout>
