---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Path from 'node:path';

import BaseLayout from '../../../layouts/Base.astro';

const examples = import.meta.glob('../../../data/examples/musicxml-reference/*.md', { eager: true });
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/**/*.png');

const frontmatter = {
  title: 'MusicXML example documents',
}
---
<BaseLayout frontmatter={frontmatter}>
  {Object.values(examples).sort((a,b) => a.frontmatter.title.localeCompare(b.frontmatter.title)).map(example => {
    const name = Path.parse(example.file).name;
    const image = `/src/assets/img/${example.frontmatter.tutorial ? 'tutorial' : 'examples'}/${name}.png`;
    return (
      <Fragment>{image in images && <Image src={images[image]()} alt={name} />}</Fragment>
      <a href={"/musicxml/musicxml-reference/examples/" + name + "/"}>{example.frontmatter.title}</a>
      <p/>
    );
  })}
</BaseLayout>
