---
import Path from 'node:path';

import BaseLayout from '../../../layouts/Base.astro';

const examples = import.meta.glob('../../../examples/musicxml-reference/*.md', { eager: true });

const frontmatter = {
  title: 'MusicXML example documents',
}
---
<BaseLayout frontmatter={frontmatter}>
  {Object.values(examples).map((example) => (
    <a href={"/musicxml/musicxml-reference/examples/" + Path.parse(example.file).name + "/"}>{example.frontmatter.title}</a>
    <p/>
  ))}
</BaseLayout>
