---
import { getCollection } from 'astro:content';
import ExampleCode from '@components/ExampleCode.astro';
import BaseLayout from '@layouts/Base.astro';

export async function getStaticPaths() {
  const examples = await getCollection('musicxmlExamples');
  return examples.map(example => ({
    params: { id: example.id },
    props: { example }
  }));
}

const { example } = Astro.props;
const frontmatter = {
  title: example.data.title,
  pagefindMeta: `Example: ${example.data.title}`,
  pagefindWeight: 5
};
---
<BaseLayout frontmatter={frontmatter}>
  <ExampleCode example={example} schema="musicxml"/>
</BaseLayout>
