---
import { getCollection } from 'astro:content';

import BaseLayout from '../../../layouts/Base.astro';
import DataTypeLink from '@components/DataTypeLink.astro';

const datatypes = await getCollection('musicxmlDatatypes');
const frontmatter = {
  title: 'Data types used in MusicXML'
}

// Extract the h2 and h3 headings needed for the PageNav component.
const headings = Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))
.map(letter => {
  return {
    depth: 2,
    slug: datatypes.find(datatype => 0 === datatype.id.charAt(0).localeCompare(letter, undefined, { sensitivity: 'base' }))?.id,
    text: letter
  };
})
.filter(heading => !!heading.slug);
---
<BaseLayout frontmatter={ frontmatter } headings={ headings }>
  <ul class="listing">
    {datatypes.map(datatype => (
      <li><DataTypeLink type={datatype.data.name} schema="musicxml"/></li>
    ))}
  </ul>
</BaseLayout>
