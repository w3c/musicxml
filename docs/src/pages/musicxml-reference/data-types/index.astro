---
import { getCollection } from 'astro:content';

import BaseLayout from '../../../layouts/Base.astro';
import DataTypeLink from '@components/DataTypeLink.astro';

const datatypes = await getCollection('musicxmlDatatypes');
const frontmatter = {
  title: 'Data types used in MusicXML'
}
---
<BaseLayout frontmatter={frontmatter}>
  <ul>
    {datatypes.map(datatype => (
      <li><DataTypeLink type={datatype.data.name} schema="musicxml"/></li>
    ))}
  </ul>
</BaseLayout>
